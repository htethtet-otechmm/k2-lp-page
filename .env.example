# Gmail SMTP settings. These values are server-only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-account@gmail.com
# Use a Google App Password, not your normal Google password.
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_RECEIVER_EMAIL=enquiry@example.com
# Optional; defaults to SMTP_USER. Gmail may require this to match SMTP_USER.
SMTP_FROM_EMAIL=your-account@gmail.com
